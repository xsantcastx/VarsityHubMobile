+ * - usedCachedAccess?: boolean - whether they used the 48h grace period instead of live location
  */
 export async function verifyEventPostingPermission(
   eventId: string,
   userId: string,
   userLat: number | null,
   userLon: number | null
-): Promise<{ allowed: boolean; reason?: string; distance?: number }> {
+): Promise<{
