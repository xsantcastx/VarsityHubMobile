<!-- Template: Event Approved (EVENT_APPROVED) -->
<!-- Template ID: d-e76de706704646938e05a28e4c1a20d3 -->
<!-- Source Name: Event Aproved - VH -->
<!-- Subject: Your event {{eventName}} was approved -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Event Approved - VarsityHub</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #ffffff;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <!-- Main Container -->
                <table role="presentation" style="width: 100%; max-width: 600px; border-collapse: collapse;">
                    
                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding-bottom: 32px;">
                            <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765655742/6C37232F-74BC-4486-95A1-7EE208A63D06_aj2j8k.png" alt="VarsityHub" style="width: 100px; height: 100px; display: block;" />
                        </td>
                    </tr>

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding-bottom: 24px;">
                            <h1 style="margin: 0; font-size: 24px; color: #111827; font-weight: 700;">
                                🎉 Your Event is Now Live!
                            </h1>
                        </td>
                    </tr>

                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 0 20px 32px;">
                            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151;">
                                Hi {{coachName}},
                            </p>
                            
                            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151;">
                                Great news! <strong>{{eventName}}</strong> has been approved and is now live on VarsityHub. Share this event with your team and community!
                            </p>

                            <!-- Status Badge -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                                <tr>
                                    <td align="center">
                                        <div style="display: inline-block; padding: 8px 16px; background-color: #10b981; color: #ffffff; border-radius: 6px; font-size: 14px; font-weight: 700;">
                                            ✓ APPROVED
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Event Details Box -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="margin: 0 0 16px; font-size: 16px; color: #065f46; font-weight: 700;">
                                            📅 Event Details
                                        </p>
                                        <table role="presentation" style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Event Name:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{eventName}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Date:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{eventDate}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Time:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{eventTime}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Location:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{eventLocation}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Opponent:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{opponent}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Organization:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{organizationName}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Approval Notes (optional - only shows if approval_notes exists) -->
                            {{#if approval_notes}}
                            <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #fef3c7; border-left: 4px solid #fbbf24; border-radius: 4px; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 16px;">
                                        <p style="margin: 0 0 8px; font-size: 14px; color: #92400e; font-weight: 700;">
                                            📝 Reviewer Notes
                                        </p>
                                        <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #92400e;">
                                            {{approvalNotes}}
                                        </p>
                                    </td>
                                </tr>
                            </table>
                            {{/if}}

                            <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #6b7280;">
                                Your event is now visible to the community. Share the link with your team, parents, and fans to boost attendance!
                            </p>

                            <!-- CTA Buttons -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                                <tr>
                                    <td align="center" style="padding: 0 0 12px 0;">
                                        <a href="{{eventLink}}" style="display: inline-block; padding: 14px 28px; background-color: #10b981; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">
                                            View Live Event
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding: 0;">
                                        <a href="{{manageLink}}" style="display: inline-block; padding: 14px 28px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; border: 1px solid #d1d5db;">
                                            Manage Event
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 24px 0 0; font-size: 13px; line-height: 1.6; color: #9ca3af; text-align: center;">
                                Need to make changes? Click "Manage Event" to update details.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <!-- Footer -->
<!-- Canonical VarsityHub Footer Snippet (light theme) -->
<tr>
  <td style="padding:32px 24px;text-align:center;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
    <p style="margin:0 0 16px;font-size:13px;color:#4b5563;">Follow us on social media</p>
    <div style="text-align:center;">
      <a href="https://www.instagram.com/varsityhub_?igsh=cGQ1ZDM2NzVxNm13" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
      <a href="https://www.tiktok.com/@varsity.hub?_r=1&_t=ZT-92J1z0MRGpi" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://cdn-icons-png.flaticon.com/512/3046/3046121.png" alt="TikTok" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
      <a href="https://youtube.com/@varsityhub?si=XTvXQD0P7GAeo9n-" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://cdn-icons-png.flaticon.com/512/1384/1384060.png" alt="YouTube" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
      <a href="https://www.facebook.com/share/17t7MJa9vx/?mibextid=wwXIfr" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
      <a href="https://x.com/varsityhub00" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/X_logo_2023_original.svg" alt="X" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
      <a href="https://limeprod.com" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765997882/365220-200_mvbdz7.png" alt="LimeProd.com" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
    </div>
    <p style="margin:20px 0 8px;font-size:13px;color:#6b7280;">
      <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#6b7280;text-decoration:none;">Privacy Policy</a>
      &nbsp;•&nbsp;
      <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#6b7280;text-decoration:none;">Community Guidelines</a>
    </p>
    <p style="margin:0;font-size:12px;color:#9ca3af;">© 2025 LIME PRODUCTIONS. All rights reserved.</p>
  </td>
</tr>
</table>
            </td>
        </tr>
    </table>
</body>
</html>
