<!-- Template: Staff Member Joined (STAFF_MEMBER_JOINED) -->
<!-- Template ID: d-a04998552fdb4508be4c1e31778057f2 -->
<!-- Source Name: Staff member joined - VH  -->
<!-- Subject: {{staffName}} joined {{teamName}} -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Member Joined - VarsityHub</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background-color: #ffffff;">
    <table role="presentation" style="width: 100%; border-collapse: collapse;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <!-- Main Container -->
                <table role="presentation" style="width: 100%; max-width: 600px; border-collapse: collapse;">
                    
                    <!-- Logo -->
                    <tr>
                        <td align="center" style="padding-bottom: 32px;">
                            <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765655742/6C37232F-74BC-4486-95A1-7EE208A63D06_aj2j8k.png" alt="VarsityHub" style="width: 100px; height: 100px; display: block;" />
                        </td>
                    </tr>

                    <!-- Header -->
                    <tr>
                        <td align="center" style="padding-bottom: 24px;">
                            <h1 style="margin: 0; font-size: 24px; color: #111827; font-weight: 700;">
                                🎉 New Team Member Joined!
                            </h1>
                        </td>
                    </tr>

                    <!-- Body Content -->
                    <tr>
                        <td style="padding: 0 20px 32px;">
                            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151;">
                                Hi {{recipientName}},
                            </p>
                            
                            <p style="margin: 0 0 24px; font-size: 16px; line-height: 1.6; color: #374151;">
                                Great news! <strong>{{newMemberName}}</strong> has accepted your invitation and joined <strong>{{teamName}}</strong> as a {{memberRole}}.
                            </p>

                            <!-- Status Badge -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
                                <tr>
                                    <td align="center">
                                        <div style="display: inline-block; padding: 8px 16px; background-color: #10b981; color: #ffffff; border-radius: 6px; font-size: 14px; font-weight: 700;">
                                            ✓ INVITATION ACCEPTED
                                        </div>
                                    </td>
                                </tr>
                            </table>

                            <!-- Member Details Box -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 8px; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 20px;">
                                        <p style="margin: 0 0 16px; font-size: 16px; color: #065f46; font-weight: 700;">
                                            👤 New Member Details
                                        </p>
                                        <table role="presentation" style="width: 100%; border-collapse: collapse;">
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Name:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{newMemberName}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Role:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{memberRole}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Team:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{teamName}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Organization:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{organizationName}}</td>
                                            </tr>
                                            <tr>
                                                <td style="padding: 8px 0; font-size: 14px; color: #047857;">Joined On:</td>
                                                <td style="padding: 8px 0; font-size: 14px; color: #065f46; font-weight: 600; text-align: right;">{{joinedDate}}</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- What's Next Box -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; background-color: #eff6ff; border-left: 4px solid #3b82f6; border-radius: 4px; margin-bottom: 24px;">
                                <tr>
                                    <td style="padding: 16px;">
                                        <p style="margin: 0 0 8px; font-size: 14px; color: #1e3a8a; font-weight: 700;">
                                            ✅ What's Next
                                        </p>
                                        <p style="margin: 0; font-size: 14px; line-height: 1.6; color: #1e40af;">
                                            {{newMemberName}} now has access to team features based on their role. You can manage their permissions and responsibilities in the staff management dashboard.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 0 0 24px; font-size: 14px; line-height: 1.6; color: #6b7280;">
                                Your team is growing! Make sure to welcome {{newMemberName}} and help them get started.
                            </p>

                            <!-- CTA Buttons -->
                            <table role="presentation" style="width: 100%; border-collapse: collapse; margin-bottom: 16px;">
                                <tr>
                                    <td align="center" style="padding: 0 0 12px 0;">
                                        <a href="{{viewTeamLink}}" style="display: inline-block; padding: 14px 28px; background-color: #10b981; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">
                                            View Team
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding: 0;">
                                        <a href="{{manageStaffLink}}" style="display: inline-block; padding: 14px 28px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; border: 1px solid #d1d5db;">
                                            Manage Staff
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin: 24px 0 0; font-size: 13px; line-height: 1.6; color: #9ca3af; text-align: center;">
                                Need to adjust permissions? Visit the staff management page.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <!-- Footer -->
<!-- Canonical VarsityHub Footer Snippet (light theme) -->
<tr>
  <td style="padding:32px 24px;text-align:center;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
