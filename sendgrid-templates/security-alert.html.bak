<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>VarsityHub Security Alert</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background-color:#030712;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background-color:#030712;">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" style="max-width:600px;border-collapse:collapse;background-color:#0f172a;border-radius:18px;border:1px solid #1e293b;color:#e2e8f0;">
          <tr>
            <td style="padding:32px 28px;">
              <p style="margin:0 0 8px;font-size:13px;color:#38bdf8;text-transform:uppercase;font-weight:600;letter-spacing:.8px;">Security alert</p>
              <h1 style="margin:0;font-size:26px;color:#f8fafc;">We detected a {{alert_type}} event</h1>
              <p style="margin:12px 0 0;font-size:15px;color:#cbd5f5;line-height:1.7;">Review the details below. If this wasn’t you, secure your account immediately.</p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 28px;">
              <table role="presentation" width="100%" style="border-collapse:collapse;background-color:#111c3a;border-radius:14px;border:1px solid #1d2746;">
                <tr>
                  <td style="padding:18px;">
                    <p style="margin:0 0 6px;font-size:13px;color:#94a3b8;">IP address</p>
                    <p style="margin:0;font-size:16px;color:#f1f5f9;font-weight:600;">{{ip_address}}</p>
                  </td>
                  <td style="padding:18px;border-left:1px solid #1d2746;">
                    <p style="margin:0 0 6px;font-size:13px;color:#94a3b8;">Location</p>
                    <p style="margin:0;font-size:16px;color:#f1f5f9;font-weight:600;">{{location}}</p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 32px;">
              <table role="presentation" width="100%" style="border-collapse:collapse;">
                <tr>
                  <td align="center" style="padding-bottom:14px;">
                    <a href="{{secure_account_link}}" style="display:inline-block;background-color:#f97316;color:#ffffff;text-decoration:none;padding:14px 36px;border-radius:999px;font-weight:700;font-size:15px;">Secure My Account</a>
                  </td>
                </tr>
                <tr>
                  <td align="center" style="padding-bottom:10px;">
                    <a href="{{change_password_link}}" style="display:inline-block;color:#38bdf8;font-weight:600;font-size:14px;text-decoration:none;">Reset Password</a>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <a href="{{manage_url}}" style="display:inline-block;color:#38bdf8;font-weight:600;font-size:14px;text-decoration:none;">View Recent Sessions</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 32px;">
              <div style="background-color:#0b152b;border-radius:12px;padding:18px;border:1px solid #1e293b;">
                <p style="margin:0 0 8px;font-size:14px;color:#f8fafc;font-weight:600;">Need help?</p>
                <p style="margin:0;font-size:13px;color:#cbd5f5;">Contact us any time: <a href="{{contact_support_link}}" style="color:#38bdf8;text-decoration:none;">Support Team</a></p>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:32px 24px;text-align:center;background-color:#0f172a;border-top:1px solid #1f2937;">
              <p style="margin:0 0 16px;font-size:13px;color:#94a3b8;">Follow us on social media</p>
              <div style="text-align:center;">
                <a href="https://www.instagram.com/varsityhub_?igsh=cGQ1ZDM2NzVxNm13" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://www.tiktok.com/@varsity.hub?_r=1&_t=ZT-92J1z0MRGpi" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/3046/3046121.png" alt="TikTok" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://youtube.com/@varsityhub?si=XTvXQD0P7GAeo9n-" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/1384/1384060.png" alt="YouTube" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://www.facebook.com/share/17t7MJa9vx/?mibextid=wwXIfr" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://x.com/varsityhub00" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/X_logo_2023_original.svg" alt="X" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://limeprod.com" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765997882/365220-200_mvbdz7.png" alt="LimeProd.com" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
              </div>
              <p style="margin:20px 0 8px;font-size:13px;color:#94a3b8;">
                <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#94a3b8;text-decoration:none;">Privacy Policy</a>
                &nbsp;•&nbsp;
                <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#94a3b8;text-decoration:none;">Community Guidelines</a>
              </p>
              <p style="margin:0;font-size:12px;color:#64748b;">© 2025 LIME PRODUCTIONS. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
