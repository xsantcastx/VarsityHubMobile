<!-- Template: Account Warning (ACCOUNT_WARNING) -->
<!-- Template ID: d-1548d11143ce47b28c9832cfbb0880d8 -->
<!-- Source Name: Account Warning - VH -->
<!-- Subject: Account warning from VarsityHub -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Warning - VarsityHub</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color: #ffffff;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table width="600" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color: #ffffff; max-width: 100%; width: 100%;">
                    
                    <!-- Logo -->
                    <tr>
                        <td style="padding: 0 0 30px; text-align: center;">
                            <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765655742/6C37232F-74BC-4486-95A1-7EE208A63D06_aj2j8k.png" alt="VarsityHub" width="80" height="80" style="display: block; margin: 0 auto; max-width: 80px; height: auto;" />
                        </td>
                    </tr>

                    <!-- Warning Badge -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: center;">
                            <div style="display: inline-block; background-color: #fef3c7; color: #92400e; padding: 8px 20px; border-radius: 20px; font-size: 14px; font-weight: 600;">
                                ⚠️ Account Warning
                            </div>
                        </td>
                    </tr>

                    <!-- Main Heading -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #1f2937; font-size: 32px; font-weight: 600; line-height: 1.2;">
                                Your Account Has Received a Warning
                            </h1>
                        </td>
                    </tr>

                    <!-- Greeting -->
                    <tr>
                        <td style="padding: 0 40px 10px; text-align: left;">
                            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #374151;">
                                Hi {{userName}},
                            </p>
                        </td>
                    </tr>

                    <!-- Explanation -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: left;">
                            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #374151;">
                                We've issued a warning for your VarsityHub account due to activity that violated our Community Guidelines. This is a formal notice, and while no immediate action has been taken, repeated violations may result in account suspension or permanent ban.
                            </p>
                        </td>
                    </tr>

                    <!-- Warning Details Box -->
                    <tr>
                        <td style="padding: 0 40px 24px;">
                            <div style="background-color: #fef3c7; border-left: 4px solid #f59e0b; border-radius: 8px; padding: 20px;">
                                <p style="margin: 0 0 12px; font-size: 15px; font-weight: 600; color: #92400e;">
                                    Warning Details
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #92400e;">
                                    <strong>Report ID:</strong> #{{reportId}}
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #92400e;">
                                    <strong>Report Type:</strong> {{reportType}}
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #92400e;">
                                    <strong>Violation Type:</strong> {{violationType}}
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #92400e;">
                                    <strong>Date:</strong> {{warningDate}}
                                </p>
                                <p style="margin: 0; font-size: 14px; color: #92400e;">
                                    <strong>Reason:</strong> {{warningReason}}
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- What This Means -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: left;">
                            <p style="margin: 0 0 12px; font-size: 16px; font-weight: 600; color: #1f2937;">
                                What This Means
                            </p>
                            <ul style="margin: 0; padding-left: 20px; color: #374151; font-size: 14px; line-height: 1.8;">
                                <li style="margin-bottom: 8px;">Your account remains active with no restrictions</li>
                                <li style="margin-bottom: 8px;">This warning will be kept on record for 90 days</li>
                                <li style="margin-bottom: 8px;">Future violations may result in temporary suspension or permanent ban</li>
                                <li>We encourage you to review our Community Guidelines</li>
                            </ul>
                        </td>
                    </tr>

                    <!-- CTA Buttons -->
                    <tr>
                        <td style="padding: 0 40px 20px;">
                            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                <tr>
                                    <td align="center" style="padding: 0 0 12px;">
                                        <a href="{{communityGuidelinesUrl}}" style="display: inline-block; padding: 14px 28px; background-color: #f59e0b; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">
                                            Review Community Guidelines
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding: 0;">
                                        <a href="{{appealUrl}}" style="display: inline-block; padding: 14px 28px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; border: 1px solid #d1d5db;">
                                            Submit an Appeal
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Moving Forward -->
                    <tr>
                        <td style="padding: 0 40px 30px; text-align: left;">
                            <div style="background-color: #f3f4f6; border-radius: 8px; padding: 16px;">
                                <p style="margin: 0 0 8px; font-size: 14px; font-weight: 600; color: #1f2937;">
                                    💡 Moving Forward
                                </p>
                                <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #4b5563;">
                                    We believe in second chances. Please take this opportunity to familiarize yourself with our guidelines. If you have questions or believe this warning was issued in error, you can submit an appeal using the button above.
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Support Contact -->
                    <tr>
                        <td style="padding: 0 40px 30px; text-align: left;">
                            <p style="margin: 0; color: #4b5563; font-size: 14px; line-height: 1.6;">
                                Questions? Email us at <a href="mailto:{{supportEmail}}" style="color: #10b981; text-decoration: underline;">{{supportEmail}}</a>
                            </p>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 30px 40px;">
                            <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
                                <tr>
                                    <td style="border-top: 1px solid #e5e7eb; font-size: 1px; line-height: 1px;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    
                    <!-- Footer -->
<!-- Canonical VarsityHub Footer Snippet (light theme) -->
<tr>
  <td style="padding:32px 24px;text-align:center;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
    <p style="margin:0 0 16px;font-size:13px;color:#4b5563;">Follow us on social media</p>
    <div style="text-align:center;">
      <a href="https://www.instagram.com/varsityhub_?igsh=cGQ1ZDM2NzVxNm13" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
        <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
      </a>
