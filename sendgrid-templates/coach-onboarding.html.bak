<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to VarsityHub Coaching</title>
</head>
<body style="margin:0;padding:0;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background-color:#0f172a;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="border-collapse:collapse;background:linear-gradient(135deg,#0f172a,#1d4ed8);">
    <tr>
      <td align="center" style="padding:32px 16px;">
        <table role="presentation" width="100%" style="max-width:620px;border-collapse:collapse;background-color:#ffffff;border-radius:20px;overflow:hidden;">
          <tr>
            <td style="padding:32px 28px 20px;text-align:center;">
              <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765655742/6C37232F-74BC-4486-95A1-7EE208A63D06_aj2j8k.png" alt="VarsityHub" width="68" height="68" style="display:block;margin:0 auto 12px;" />
              <p style="margin:0;font-size:13px;color:#2563eb;font-weight:600;text-transform:uppercase;letter-spacing:.8px;">Coach onboarding</p>
              <h1 style="margin:12px 0 0;font-size:28px;color:#0f172a;">Welcome aboard, {{coach_name}}</h1>
              <p style="margin:12px 0 0;font-size:15px;color:#475569;line-height:1.6;">You’re now running VarsityHub on the {{plan_name}} plan for {{team_name}} ({{organization_name}}). Here’s what’s ready for you today.</p>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 24px;">
              <table role="presentation" width="100%" style="border-collapse:collapse;background-color:#f8fafc;border-radius:16px;border:1px solid #e2e8f0;">
                <tr>
                  <td style="padding:20px;">
                    <p style="margin:0 0 8px;font-size:13px;color:#64748b;text-transform:uppercase;letter-spacing:.7px;font-weight:600;">Your plan highlights</p>
                    <ul style="margin:0;padding-left:18px;font-size:14px;color:#0f172a;line-height:1.7;">
                      {{#plan_features}}
                        <li>{{.}}</li>
                      {{/plan_features}}
                    </ul>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 32px;">
              <table role="presentation" width="100%" style="border-collapse:collapse;">
                <tr>
                  <td align="center" style="padding-bottom:12px;">
                    <a href="{{dashboard_url}}" style="display:inline-block;background-color:#2563eb;color:#ffffff;text-decoration:none;padding:16px 42px;border-radius:999px;font-weight:700;font-size:16px;">Go to Coach Dashboard</a>
                  </td>
                </tr>
                <tr>
                  <td align="center">
                    <a href="{{support_url}}" style="display:inline-block;font-size:14px;font-weight:600;color:#0f172a;text-decoration:none;">Need help? Contact VarsityHub Support →</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:0 28px 28px;">
              <div style="border:1px solid #e2e8f0;border-radius:14px;padding:18px;">
                <p style="margin:0 0 10px;font-size:15px;font-weight:600;color:#0f172a;">Next steps</p>
                <ol style="margin:0;padding-left:18px;color:#475569;font-size:14px;line-height:1.7;">
                  <li>Invite staff and set roles.</li>
                  <li>Add your upcoming schedule so families can follow.</li>
                  <li>Upload media and highlights to spark engagement.</li>
                </ol>
              </div>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:32px 24px;text-align:center;background-color:#f9fafb;border-top:1px solid #e5e7eb;">
              <p style="margin:0 0 16px;font-size:13px;color:#4b5563;">Follow us on social media</p>
              <div style="text-align:center;">
                <a href="https://www.instagram.com/varsityhub_?igsh=cGQ1ZDM2NzVxNm13" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/2111/2111463.png" alt="Instagram" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://www.tiktok.com/@varsity.hub?_r=1&_t=ZT-92J1z0MRGpi" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/3046/3046121.png" alt="TikTok" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://youtube.com/@varsityhub?si=XTvXQD0P7GAeo9n-" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/1384/1384060.png" alt="YouTube" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://www.facebook.com/share/17t7MJa9vx/?mibextid=wwXIfr" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://cdn-icons-png.flaticon.com/512/733/733547.png" alt="Facebook" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://x.com/varsityhub00" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/5/53/X_logo_2023_original.svg" alt="X" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
                <a href="https://limeprod.com" style="display:inline-block;margin:0 8px;" target="_blank" rel="noopener noreferrer">
                  <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765997882/365220-200_mvbdz7.png" alt="LimeProd.com" width="36" height="36" style="display:block;border:0;width:36px;height:36px;" />
                </a>
              </div>
              <p style="margin:20px 0 8px;font-size:13px;color:#6b7280;">
                <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#6b7280;text-decoration:none;">Privacy Policy</a>
                &nbsp;•&nbsp;
                <a href="https://limeprod.com/VarsityHubPrivacy" target="_blank" rel="noopener noreferrer" style="color:#6b7280;text-decoration:none;">Community Guidelines</a>
              </p>
              <p style="margin:0;font-size:12px;color:#9ca3af;">© 2025 LIME PRODUCTIONS. All rights reserved.</p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
