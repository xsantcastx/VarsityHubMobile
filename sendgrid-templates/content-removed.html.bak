<!-- Template: Content Removed (CONTENT_REMOVED) -->
<!-- Template ID: d-b27c753cafcb425aa7a7c9f8b577f844 -->
<!-- Source Name: Content Removed - VH -->
<!-- Subject: Your content was removed -->

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Content Removed - VarsityHub</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #ffffff;">
    <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color: #ffffff;">
        <tr>
            <td align="center" style="padding: 40px 20px;">
                <table width="600" border="0" cellpadding="0" cellspacing="0" role="presentation" style="background-color: #ffffff; max-width: 100%; width: 100%;">
                    
                    <!-- Logo -->
                    <tr>
                        <td style="padding: 0 0 30px; text-align: center;">
                            <img src="https://res.cloudinary.com/dxb5oq4fs/image/upload/v1765655742/6C37232F-74BC-4486-95A1-7EE208A63D06_aj2j8k.png" alt="VarsityHub" width="80" height="80" style="display: block; margin: 0 auto; max-width: 80px; height: auto;" />
                        </td>
                    </tr>

                    <!-- Action Badge -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: center;">
                            <div style="display: inline-block; background-color: #fee2e2; color: #991b1b; padding: 8px 20px; border-radius: 20px; font-size: 14px; font-weight: 600;">
                                🚫 Content Removed
                            </div>
                        </td>
                    </tr>

                    <!-- Main Heading -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: center;">
                            <h1 style="margin: 0; color: #1f2937; font-size: 32px; font-weight: 600; line-height: 1.2;">
                                Your Content Has Been Removed
                            </h1>
                        </td>
                    </tr>

                    <!-- Greeting -->
                    <tr>
                        <td style="padding: 0 40px 10px; text-align: left;">
                            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #374151;">
                                Hi {{userName}},
                            </p>
                        </td>
                    </tr>

                    <!-- Explanation -->
                    <tr>
                        <td style="padding: 0 40px 20px; text-align: left;">
                            <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #374151;">
                                We've removed content from your VarsityHub account because it violated our Community Guidelines. Your account remains active, but the content is no longer visible on the platform.
                            </p>
                        </td>
                    </tr>

                    <!-- Removed Content Details Box -->
                    <tr>
                        <td style="padding: 0 40px 24px;">
                            <div style="background-color: #fef2f2; border-left: 4px solid #ef4444; border-radius: 8px; padding: 20px;">
                                <p style="margin: 0 0 12px; font-size: 15px; font-weight: 600; color: #991b1b;">
                                    Removed Content Details
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #991b1b;">
                                    <strong>Report ID:</strong> #{{reportId}}
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #991b1b;">
                                    <strong>Content Type:</strong> {{contentType}}
                                </p>
                                <p style="margin: 0 0 8px; font-size: 14px; color: #991b1b;">
                                    <strong>Removed on:</strong> {{removalDate}}
                                </p>
                                <p style="margin: 0; font-size: 14px; color: #991b1b;">
                                    <strong>Reason:</strong> {{removalReason}}
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- CTA Buttons -->
                    <tr>
                        <td style="padding: 0 40px 20px;">
                            <table border="0" cellpadding="0" cellspacing="0" role="presentation" style="width: 100%;">
                                <tr>
                                    <td align="center" style="padding: 0 0 12px;">
                                        <a href="{{communityGuidelinesUrl}}" style="display: inline-block; padding: 14px 28px; background-color: #ef4444; color: #ffffff; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px;">
                                            Review Community Guidelines
                                        </a>
                                    </td>
                                </tr>
                                <tr>
                                    <td align="center" style="padding: 0;">
                                        <a href="{{appealUrl}}" style="display: inline-block; padding: 14px 28px; background-color: #f3f4f6; color: #374151; text-decoration: none; border-radius: 8px; font-weight: 600; font-size: 15px; border: 1px solid #d1d5db;">
                                            Submit an Appeal
                                        </a>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Appeal Info -->
                    <tr>
                        <td style="padding: 0 40px 30px; text-align: left;">
                            <div style="background-color: #f3f4f6; border-radius: 8px; padding: 16px;">
                                <p style="margin: 0 0 8px; font-size: 14px; font-weight: 600; color: #1f2937;">
                                    💡 Think this was a mistake?
                                </p>
                                <p style="margin: 0; font-size: 13px; line-height: 1.6; color: #4b5563;">
                                    If you believe your content was removed in error, you can submit an appeal. Our team will review your case and respond within 3-5 business days.
                                </p>
                            </div>
                        </td>
                    </tr>

                    <!-- Support Contact -->
                    <tr>
                        <td style="padding: 0 40px 30px; text-align: left;">
                            <p style="margin: 0; color: #4b5563; font-size: 14px; line-height: 1.6;">
                                Questions? Email us at <a href="mailto:customerservice@varsityhub.app" style="color: #10b981; text-decoration: underline;">customerservice@varsityhub.app</a>
                            </p>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td style="padding: 30px 40px;">
                            <table width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation">
                                <tr>
                                    <td style="border-top: 1px solid #e5e7eb; font-size: 1px; line-height: 1px;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    
                    <!-- Footer -->
<!-- Canonical VarsityHub Footer Snippet (light theme) -->
