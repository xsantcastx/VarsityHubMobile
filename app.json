{
  "expo": {
    "name": "VarsityHub",
    "slug": "varsityhub",
    "owner": "varsity-hub",
    "version": "1.0.1",
    "runtimeVersion": "1.0.1",
    "description": "The ultimate sports team management and social platform for athletes, coaches, and fans.",
    "githubUrl": "https://github.com/xsantcastx/VarsityHubMobile",
    "icon": "./assets/images/icon.png",
    "scheme": "varsityhubmobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "orientation": "portrait",
    "locales": {
      "en": "./locales/en.json"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.varsithub.varsityhub",
      "usesAppleSignIn": true,
      "config": {
        "googleMapsApiKey": "AIzaSyD41NuiCoah1ed8P1HVlucciSlBaNMyKBY"
      },
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "VarsityHub needs camera access to capture photos and videos for your sports content.",
        "NSMicrophoneUsageDescription": "VarsityHub needs microphone access to record videos with sound.",
        "NSPhotoLibraryUsageDescription": "VarsityHub needs photo library access to select images for your posts and profile.",
        "NSLocationWhenInUseUsageDescription": "VarsityHub needs your location to show nearby events on the map."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "package": "com.varsithub.varsityhub",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyD41NuiCoah1ed8P1HVlucciSlBaNMyKBY"
        }
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow VarsityHub to access your photos to attach images to posts.",
          "cameraPermission": "Allow VarsityHub to use the camera for capturing photos and videos.",
          "microphonePermission": "Allow VarsityHub to access the microphone for recording videos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow VarsityHub to use your location to show nearby events.",
          "locationWhenInUsePermission": "Allow VarsityHub to use your location to show nearby events on the map."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow VarsityHub to access your photos.",
          "savePhotosPermission": "Allow VarsityHub to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-video",
      "expo-web-browser",
      "expo-secure-store",
      "expo-font",
      "expo-audio",
      "expo-apple-authentication",
      "expo-asset",
      "./plugins/withAndroidManifestCleanup",
      "./plugins/withAndroidBuildConfig"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "64489ed7-a8c0-41de-91ec-5846ea79a27f"
      },
      "EXPO_PUBLIC_API_URL": "https://api-production-8ac3.up.railway.app",
      "EXPO_PUBLIC_FORCE_REMOTE_API": "1",
      "EXPO_PUBLIC_NODE_ENV": "development",
      "EXPO_PUBLIC_APP_SCHEME": "varsityhubmobile",
      "EXPO_PUBLIC_WEB_BASE_URL": "https://varsityhub.app",
      "EXPO_PUBLIC_SENTRY_DSN": "",
      "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "",
      "EXPO_PUBLIC_ADMIN_EMAILS": "emancero@varsityhub.app",
      "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "316424843313-kte6qvms4kbmsii5o0b0o3jjndhs709s.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "316424843313-n0i9t49uoh2e9038m5b927vrm9cv77qr.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "316424843313-3r9h72gqse6va030qr17lmll8ia3b9vb.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID": "316424843313-3r9h72gqse6va030qr17lmll8ia3b9vb.apps.googleusercontent.com",
      "EXPO_PUBLIC_GOOGLE_FORCE_PROXY": "0",
      "EXPO_PUBLIC_GOOGLE_MAPS_API_KEY": "AIzaSyD41NuiCoah1ed8P1HVlucciSlBaNMyKBY",
      "EXPO_PUBLIC_EXPO_PROJECT_FULL_NAME": "@varsityhub/varsityhub"
    }
  }
}
