# =============================================================================
# VarsityHub Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in Railway's environment variables UI

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway provides DATABASE_URL automatically - use this for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/varsityhub?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAILS=admin@varsityhub.com,owner@varsityhub.com

# -----------------------------------------------------------------------------
# Google OAuth & Maps
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Email Service (SendGrid via Twilio)
# -----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com/
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@varsityhub.com
# Non-production only: redirect ALL outgoing emails to this address (leave blank in production)
EMAIL_OVERRIDE_TO=

# SendGrid Dynamic Template IDs
# Create templates at: https://mc.sendgrid.com/dynamic-templates
# Each template should have placeholders for dynamic content (see docs/SENDGRID_TEMPLATES.md)
#
# CRITICAL (required for launch):
SENDGRID_VERIFICATION_TEMPLATE_ID=d-your-verification-template-id
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-your-password-reset-template-id
SENDGRID_TEAM_INVITE_TEMPLATE_ID=d-your-team-invite-template-id
SENDGRID_ORG_INVITE_TEMPLATE_ID=d-your-org-invite-template-id
SENDGRID_BILLING_NOTICE_TEMPLATE_ID=d-your-billing-notice-template-id
#
# RECOMMENDED (add post-launch — emails silently skip if missing):
SENDGRID_PASSWORD_CHANGED_TEMPLATE_ID=d-
SENDGRID_ACCOUNT_RECOVERY_TEMPLATE_ID=d-
SENDGRID_LOGIN_NEW_DEVICE_TEMPLATE_ID=d-
SENDGRID_ACCOUNT_WARNING_TEMPLATE_ID=d-
SENDGRID_CONTENT_REMOVED_TEMPLATE_ID=d-
SENDGRID_ACCOUNT_SUSPENSION_7_DAYS_TEMPLATE_ID=d-
SENDGRID_ACCOUNT_SUSPENSION_45_DAYS_TEMPLATE_ID=d-
SENDGRID_ACCOUNT_PERMANENT_BAN_TEMPLATE_ID=d-
SENDGRID_REPORT_RESOLVED_TEMPLATE_ID=d-
SENDGRID_REPORT_DISMISSED_TEMPLATE_ID=d-
SENDGRID_CONTENT_MODERATION_TEMPLATE_ID=d-
SENDGRID_ABUSE_REPORT_TEMPLATE_ID=d-
SENDGRID_JOIN_REQUEST_ADMIN_TEMPLATE_ID=d-
SENDGRID_JOIN_REQUEST_APPROVED_TEMPLATE_ID=d-
SENDGRID_JOIN_REQUEST_DENIED_TEMPLATE_ID=d-
SENDGRID_ORG_APPROVAL_TEMPLATE_ID=d-
SENDGRID_ORG_DENIAL_TEMPLATE_ID=d-
SENDGRID_STAFF_MEMBER_JOINED_TEMPLATE_ID=d-
SENDGRID_ROSTER_THRESHOLD_TEMPLATE_ID=d-
SENDGRID_EVENT_SUBMISSION_RECEIVED_TEMPLATE_ID=d-
SENDGRID_EVENT_APPROVED_TEMPLATE_ID=d-
SENDGRID_EVENT_DENIED_TEMPLATE_ID=d-
SENDGRID_EVENT_REMINDER_TEMPLATE_ID=d-
SENDGRID_EVENT_UPDATED_TEMPLATE_ID=d-
SENDGRID_EVENT_CANCELED_TEMPLATE_ID=d-
SENDGRID_EVENT_RSVP_CONFIRMED_TEMPLATE_ID=d-
SENDGRID_PAYMENT_FAILED_TEMPLATE_ID=d-
SENDGRID_SUBSCRIPTION_EXPIRING_TEMPLATE_ID=d-
SENDGRID_AD_GOES_LIVE_TEMPLATE_ID=d-
SENDGRID_AD_PAYMENT_CONFIRMED_TEMPLATE_ID=d-
SENDGRID_AD_PENDING_REVIEW_TEMPLATE_ID=d-
SENDGRID_AD_APPROVED_TEMPLATE_ID=d-
SENDGRID_AD_REJECTED_TEMPLATE_ID=d-
SENDGRID_DAILY_TRANSACTION_REPORT_TEMPLATE_ID=d-
SENDGRID_FOUNDER_METRICS_TEMPLATE_ID=d-
#
# Optional (not used in code yet):
SENDGRID_ATHLETE_INVITATION_TEMPLATE_ID=d-
SENDGRID_ROLE_ASSIGNMENT_TEMPLATE_ID=d-
SENDGRID_INVITATION_DECLINED_TEMPLATE_ID=d-
SENDGRID_TEAM_ROSTER_UPDATE_TEMPLATE_ID=d-
SENDGRID_USER_CONFIRMATION_TEMPLATE_ID=d-

# Customer Service Email (receives abuse reports)
CUSTOMER_SERVICE_EMAIL=customerservice@varsityhub.com

# -----------------------------------------------------------------------------
# Cloudinary (Image/Video Storage)
# -----------------------------------------------------------------------------
# Sign up at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs for membership tiers
# Create these in Stripe Dashboard -> Products -> Pricing
STRIPE_PRICE_VETERAN=price_veteran_tier_id
STRIPE_PRICE_LEGEND=price_legend_tier_id
STRIPE_PRICE_AD_WEEKDAY=price_ad_weekday_id
STRIPE_PRICE_AD_WEEKEND=price_ad_weekend_id

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:9500,http://localhost:5173,http://localhost:8081
APP_BASE_URL=http://localhost:4000
APP_SCHEME=varsityhubmobile
APP_RETURN_PATH=

# -----------------------------------------------------------------------------
# Error Tracking (Optional - Sentry)
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
RATE_LIMIT_DISABLE=0

# -----------------------------------------------------------------------------
# Health Check (Optional - for verify-railway-env.sh without JWT)
# -----------------------------------------------------------------------------
# Set in Railway, then run: HEALTH_KEY=your-secret ./scripts/verify-railway-env.sh
HEALTH_CHECK_SECRET=your-random-secret

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Apple Sign In & IAP
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=your_value_here
APPLE_BUNDLE_ID=com.varsithub.varsityhub-ios
APPLE_IAP_SHARED_SECRET=your_value_here

# -----------------------------------------------------------------------------
# Twilio (Phone Verification)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_value_here
TWILIO_AUTH_TOKEN=your_value_here
TWILIO_VERIFY_SERVICE_SID=your_value_here
TWILIO_FROM_PHONE=your_value_here

# -----------------------------------------------------------------------------
# Google Play & App Store (For Mobile App Publishing)
# -----------------------------------------------------------------------------
# These are configured in app.json and eas.json
# iOS: Apple Developer Account required
# Android: Google Play Console required
# See: https://docs.expo.dev/submit/introduction/
