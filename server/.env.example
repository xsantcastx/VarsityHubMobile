# =============================================================================
# VarsityHub Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in Railway's environment variables UI

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway provides DATABASE_URL automatically - use this for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/varsityhub?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAILS=admin@varsityhub.com,owner@varsityhub.com

# -----------------------------------------------------------------------------
# Google OAuth & Maps
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Email Service (SendGrid via Twilio)
# -----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com/
# For SendGrid SMTP, user is always "apikey" (literal string)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key-here
FROM_EMAIL=noreply@varsityhub.com

# -----------------------------------------------------------------------------
# Cloudinary (Image/Video Storage)
# -----------------------------------------------------------------------------
# Sign up at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs for membership tiers
# Create these in Stripe Dashboard -> Products -> Pricing
STRIPE_PRICE_VETERAN=price_veteran_tier_id
STRIPE_PRICE_LEGEND=price_legend_tier_id

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:9500,http://localhost:5173,http://localhost:8081
APP_BASE_URL=http://localhost:4000
APP_SCHEME=varsityhubmobile
APP_RETURN_PATH=

# -----------------------------------------------------------------------------
# Error Tracking (Optional - Sentry)
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
RATE_LIMIT_DISABLE=0

# -----------------------------------------------------------------------------
# Apple Sign In
# -----------------------------------------------------------------------------
# Note: Apple authentication currently handled client-side
# TODO: Add server-side token verification for production
# No server environment variables needed yet

# -----------------------------------------------------------------------------
# Google Play & App Store (For Mobile App Publishing)
# -----------------------------------------------------------------------------
# These are configured in app.json and eas.json
# iOS: Apple Developer Account required
# Android: Google Play Console required
# See: https://docs.expo.dev/submit/introduction/
