# =============================================================================
# VarsityHub Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in Railway's environment variables UI

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway provides DATABASE_URL automatically - use this for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/varsityhub?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAILS=admin@varsityhub.app,owner@varsityhub.app

# -----------------------------------------------------------------------------
# Google OAuth & Maps
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# MUST include ALL client IDs used by the app (iOS, Android, Web/Expo).
# App uses: iOS, Android, Web - see app.json extra EXPO_PUBLIC_GOOGLE_*_CLIENT_ID
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Email Service (SendGrid via Twilio)
# -----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com/
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@varsityhub.app
# Non-production only: redirect ALL outgoing emails to this address (leave blank in production)
EMAIL_OVERRIDE_TO=

# SendGrid Dynamic Template IDs
# Create templates at: https://mc.sendgrid.com/dynamic-templates
# Each template should have placeholders for dynamic content (see docs/SENDGRID_TEMPLATES.md)
