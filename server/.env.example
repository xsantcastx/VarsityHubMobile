# =============================================================================
# VarsityHub Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in Railway's environment variables UI

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway provides DATABASE_URL automatically - use this for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/varsityhub?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAILS=admin@varsityhub.app,owner@varsityhub.app

# -----------------------------------------------------------------------------
# Google OAuth & Maps
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
# MUST include ALL client IDs used by the app (iOS, Android, Web/Expo).
# App uses: iOS, Android, Web - see app.json extra EXPO_PUBLIC_GOOGLE_*_CLIENT_ID
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Email Service (SendGrid via Twilio)
# -----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com/
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
DEMO_ACCOUNT_PASSWORD=apple-review-demo-password
FROM_EMAIL=noreply@varsityhub.app
# Non-production only: redirect ALL outgoing emails to this address (leave blank in production)
EMAIL_OVERRIDE_TO=

# SendGrid Dynamic Template IDs (16 active templates)
# Create templates at: https://mc.sendgrid.com/dynamic-templates
#
# ═══ REQUIRED (server exits in production if missing) ═══
SENDGRID_VERIFICATION_TEMPLATE_ID=d-584a4a9fe16449078e2cbc6d9d7be0d0
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-97a704ec6a35434195364e0ed9dfaf21
SENDGRID_TEAM_INVITE_TEMPLATE_ID=d-14788def39174bb6bf186716cce166fa
SENDGRID_ORG_INVITE_TEMPLATE_ID=d-bc3bd0a683c843bf932721dafce626a3
SENDGRID_BILLING_NOTICE_TEMPLATE_ID=
#
# ═══ Approval Flows ═══
SENDGRID_ABUSE_REPORT_TEMPLATE_ID=
SENDGRID_AD_PENDING_REVIEW_TEMPLATE_ID=
SENDGRID_AD_APPROVED_TEMPLATE_ID=
SENDGRID_AD_REJECTED_TEMPLATE_ID=
SENDGRID_EVENT_APPROVED_TEMPLATE_ID=d-e76de706704646938e05a28e4c1a20d3
SENDGRID_EVENT_DENIED_TEMPLATE_ID=d-503431dd78274a628f43a1e6c1592b14
SENDGRID_JOIN_REQUEST_ADMIN_TEMPLATE_ID=
SENDGRID_LEAGUE_PENDING_APPROVAL_TEMPLATE_ID=
SENDGRID_ADMIN_ACTION_CONFIRMATION_TEMPLATE_ID=
SENDGRID_ORG_APPROVAL_TEMPLATE_ID=
SENDGRID_ORG_DENIAL_TEMPLATE_ID=
SENDGRID_JOIN_REQUEST_APPROVED_TEMPLATE_ID=d-8042e5d1080f414bb537ea7edf985cb1
SENDGRID_JOIN_REQUEST_DENIED_TEMPLATE_ID=d-2b5f7fd43ab04849b4e6d3c0d889bebc

# Customer Service Email (receives abuse reports)
CUSTOMER_SERVICE_EMAIL=customerservice@varsityhub.app

# -----------------------------------------------------------------------------
# Cloudinary (Image/Video Storage)
# -----------------------------------------------------------------------------
# Sign up at: https://cloudinary.com/users/register/free
# Get real values from: Cloudinary Console → API Keys (no quotes, no trailing spaces)
# Verify: npx tsx scripts/verify-cloudinary.ts
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Price IDs for membership tiers
# Create these in Stripe Dashboard -> Products -> Pricing
STRIPE_PRICE_VETERAN=price_veteran_tier_id
STRIPE_PRICE_LEGEND=price_legend_tier_id
STRIPE_PRICE_AD_WEEKDAY=price_ad_weekday_id
STRIPE_PRICE_AD_WEEKEND=price_ad_weekend_id

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:9500,http://localhost:5173,http://localhost:8081
APP_BASE_URL=http://localhost:4000
APP_SCHEME=varsityhubmobile
APP_RETURN_PATH=

# -----------------------------------------------------------------------------
# Error Tracking (Optional - Sentry)
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io/
SENTRY_DSN=https://dba14af58de85862ac7f1cb132e19ff5@o4510445730070528.ingest.us.sentry.io/4510445740687360

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
RATE_LIMIT_DISABLE=0

# -----------------------------------------------------------------------------
# Health Check (Optional - for verify-railway-env.sh without JWT)
# -----------------------------------------------------------------------------
# Set in Railway, then run: HEALTH_KEY=your-secret ./scripts/verify-railway-env.sh
HEALTH_CHECK_SECRET=your-random-secret

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Apple Sign In & IAP
# -----------------------------------------------------------------------------
APPLE_CLIENT_ID=your_value_here
APPLE_BUNDLE_ID=com.varsithub.varsityhub-ios
APPLE_IAP_SHARED_SECRET=your_value_here

# -----------------------------------------------------------------------------
# Twilio (Phone Verification)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_value_here
TWILIO_AUTH_TOKEN=your_value_here
TWILIO_VERIFY_SERVICE_SID=your_value_here
TWILIO_FROM_PHONE=your_value_here

# -----------------------------------------------------------------------------
# Google Play & App Store (For Mobile App Publishing)
# -----------------------------------------------------------------------------
# These are configured in app.json and eas.json
# iOS: Apple Developer Account required
# Android: Google Play Console required
# See: https://docs.expo.dev/submit/introduction/
