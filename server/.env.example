# =============================================================================
# VarsityHub Server - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values
# For Railway deployment, set these in Railway's environment variables UI

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Railway provides DATABASE_URL automatically - use this for local development
DATABASE_URL=postgresql://postgres:password@localhost:5432/varsityhub?sslmode=disable

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-this-to-a-long-random-string-in-production
ADMIN_EMAILS=admin@varsityhub.com,owner@varsityhub.com
SUPPORT_EMAIL=support@varsityhub.com
APPEALS_EMAIL=appeals@varsityhub.com

# -----------------------------------------------------------------------------
# Google OAuth & Maps
# -----------------------------------------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com,your-web-client-id.apps.googleusercontent.com
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# -----------------------------------------------------------------------------
# Email Service (SendGrid via Twilio)
# -----------------------------------------------------------------------------
# Sign up at: https://sendgrid.com/
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here
FROM_EMAIL=noreply@varsityhub.com
SENDGRID_CLICK_TRACKING_ENABLED=0

# SendGrid Dynamic Template IDs
# Create templates at: https://mc.sendgrid.com/dynamic-templates
# Each template should have placeholders for dynamic content (see docs/SENDGRID_TEMPLATES.md)
SENDGRID_VERIFICATION_TEMPLATE_ID=d-your-verification-template-id
SENDGRID_TEAM_INVITE_TEMPLATE_ID=d-your-team-invite-template-id
SENDGRID_ORG_INVITE_TEMPLATE_ID=d-your-org-invite-template-id
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-your-password-reset-template-id
SENDGRID_PASSWORD_CHANGED_TEMPLATE_ID=d-your-password-changed-template-id
SENDGRID_ACCOUNT_RECOVERY_TEMPLATE_ID=d-your-account-recovery-template-id
SENDGRID_LOGIN_NEW_DEVICE_TEMPLATE_ID=d-your-login-new-device-template-id
SENDGRID_SECURITY_ALERT_TEMPLATE_ID=d-your-security-alert-template-id
SENDGRID_ABUSE_REPORT_TEMPLATE_ID=d-your-abuse-report-template-id
SENDGRID_JOIN_REQUEST_ADMIN_TEMPLATE_ID=d-your-join-request-admin-template-id
SENDGRID_JOIN_REQUEST_APPROVED_TEMPLATE_ID=d-your-join-approved-template-id
SENDGRID_JOIN_REQUEST_DENIED_TEMPLATE_ID=d-your-join-denied-template-id
SENDGRID_ORG_APPROVAL_TEMPLATE_ID=d-your-org-approval-template-id
SENDGRID_ORG_DENIAL_TEMPLATE_ID=d-your-org-denial-template-id
SENDGRID_CONTENT_MODERATION_TEMPLATE_ID=d-your-content-moderation-template-id
SENDGRID_BILLING_NOTICE_TEMPLATE_ID=d-your-billing-notice-template-id

# Customer Service Email (receives abuse reports)
CUSTOMER_SERVICE_EMAIL=customerservice@varsityhub.com

# -----------------------------------------------------------------------------
# Redis & Queue System (For Email Jobs & Background Tasks)
# -----------------------------------------------------------------------------
# For local development: Install Redis with `brew install redis` (macOS) or Docker
# For production: Use Railway Redis Add-on or Redis Cloud
# Railway provides REDIS_URL automatically - use this for local development
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Twilio (SMS / Verify)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_PHONE=+15551234567
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# Cloudinary (Image/Video Storage)
# -----------------------------------------------------------------------------
# Sign up at: https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Stripe (Payments & Subscriptions)
# -----------------------------------------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# Stripe Price IDs for membership tiers
# Create these in Stripe Dashboard -> Products -> Pricing
STRIPE_PRICE_VETERAN=price_veteran_tier_id
STRIPE_PRICE_LEGEND=price_legend_tier_id

# -----------------------------------------------------------------------------
# App Configuration
# -----------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:9500,http://localhost:5173,http://localhost:8081,https://varsityhub.app,https://app.varsityhub.app
APP_BASE_URL=http://localhost:4000
APP_SCHEME=varsityhubmobile
APP_RETURN_PATH=

# Optional web client URL used for some redirects (billing)
FRONTEND_URL=http://localhost:8081

# -----------------------------------------------------------------------------
# Error Tracking (Optional - Sentry)
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io/
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Rate Limiting (Optional)
# -----------------------------------------------------------------------------
RATE_LIMIT_DISABLE=0

# -----------------------------------------------------------------------------
# Apple Sign In
# -----------------------------------------------------------------------------
# Note: Apple authentication currently handled client-side
# TODO: Add server-side token verification for production
# No server environment variables needed yet
APPLE_BUNDLE_ID=com.xsantcastx.varsityhub

# -----------------------------------------------------------------------------
# Google Play & App Store (For Mobile App Publishing)
# -----------------------------------------------------------------------------
# These are configured in app.json and eas.json
# iOS: Apple Developer Account required
# Android: Google Play Console required
# See: https://docs.expo.dev/submit/introduction/
