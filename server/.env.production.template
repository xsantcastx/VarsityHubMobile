# Production Environment Variables Template
# Copy this to server/.env.production and fill in your production values
# ⚠️  NEVER commit real secrets to this file — use your hosting platform's env vars

# Database (Railway/Render/Supabase)
DATABASE_URL=postgresql://username:password@hostname:port/database_name?sslmode=require&connection_limit=10

# Application
JWT_SECRET=generate-a-64-char-random-string-with-openssl-rand-hex-32
PORT=4000
NODE_ENV=production

# Email Configuration (SendGrid recommended for production)
SENDGRID_API_KEY=SG.your-production-sendgrid-key
FROM_EMAIL=noreply@varsityhub.app
CUSTOMER_SERVICE_EMAIL=support@varsityhub.app
ADMIN_EMAILS=your-admin@varsityhub.app

# CORS - Restrict to your actual domains
ALLOWED_ORIGINS=https://varsityhub.app,https://app.varsityhub.app

# Production URLs (Update with your deployed server URL)
APP_BASE_URL=https://your-app-name.railway.app
APP_SCHEME=varsityhubmobile

# Stripe (get from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PRICE_VETERAN=price_YOUR_VETERAN_PRICE_ID
STRIPE_PRICE_LEGEND=price_YOUR_LEGEND_PRICE_ID
STRIPE_PRICE_AD_WEEKDAY=price_YOUR_AD_WEEKDAY_PRICE_ID
STRIPE_PRICE_AD_WEEKEND=price_YOUR_AD_WEEKEND_PRICE_ID

# Google Maps
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
GOOGLE_MAPS_DEFAULT_COUNTRY=US

# Google OAuth
GOOGLE_OAUTH_CLIENT_IDS=your-ios-client.apps.googleusercontent.com,your-web-client.apps.googleusercontent.com

# Cloudinary (media uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Error Tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id