{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/features/*": [
        "src/features/*"
      ],
      "@/shared/*": [
        "src/shared/*"
      ],
      "@/api/*": [
        "api/*"
      ],
      "@/components/*": [
        "components/*"
      ],
      "@/app/*": [
        "app/*"
      ],
      "@/constants/*": [
        "constants/*"
      ],
      "@/hooks/*": [
        "hooks/*"
      ],
      "@/context/*": [
        "context/*"
      ],
      "@/utils/*": [
        "utils/*"
      ],
      "@/config/*": [
        "config/*"
      ],
      "@/data/*": [
        "data/*"
      ],
      "@/assets/*": [
        "assets/*"
      ],
      "@/types/*": [
        "types/*"
      ],
      "@/ui/*": [
        "components/ui/*"
      ],
      "react-native-calendars": [
        "types/react-native-calendars.d.ts"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native",
      "jest"
    ]
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "data/**/*.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "api/**/*.ts",
    "api/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "constants/**/*.ts",
    "constants/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "jest.setup.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "types/**/*.d.ts"
  ]
}
