# VarsityHub Mobile - Environment Variables

# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_SCHEME=varsityhubmobile
EXPO_PUBLIC_NODE_ENV=development

# Google OAuth Configuration (Optional - for "Sign in with Google")
# Get these from: https://console.cloud.google.com/apis/credentials
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-expo-client-id.apps.googleusercontent.com

# Note: If Google OAuth is not configured, the app will show:
# "Google sign in unavailable - Configure Google OAuth client IDs to enable one-tap login"
# Users can still sign in using email/password

# Stripe Configuration (Optional - for subscriptions and ad payments)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Analytics (Optional)
# EXPO_PUBLIC_ANALYTICS_ID=...

# --- Production (Railway) ---
# When pointing the app to your Railway API, set:
# EXPO_PUBLIC_API_URL=https://<your-service>.up.railway.app
# EXPO_PUBLIC_FORCE_REMOTE_API=true
# If you prefer to use local API in dev and only fallback to remote when local fails:
# EXPO_PUBLIC_USE_LOCAL_API=true

# --- Feature Flags ---
# Force the app feed to display bundled sample events regardless of API data.
# Useful for demos and regression tests.
# EXPO_PUBLIC_FORCE_SAMPLE_FEED=false
