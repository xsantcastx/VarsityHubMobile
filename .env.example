# VarsityHub Mobile (Expo) - Environment Variables
#
# IMPORTANT: The server validates required environment variables on startup.
# If required vars are missing, the server will refuse to boot with a clear error message.
# Required vars: DATABASE_URL, JWT_SECRET (32+ chars)
#
# Quick start:
#   1. Copy this file to .env
#   2. Fill in required values (DATABASE_URL, JWT_SECRET)
#   3. Run: npm run dev
#
# API Configuration
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_SCHEME=varsityhubmobile
EXPO_PUBLIC_NODE_ENV=development
EXPO_PUBLIC_USE_LOCAL_API=true
# EXPO_PUBLIC_FORCE_REMOTE_API=true

# Sentry Monitoring (Get DSN from: https://sentry.io/settings/projects/)
EXPO_PUBLIC_SENTRY_DSN=https://your-key@sentry.io/your-project
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=1.0
# Optional release correlation. EAS can inject EAS_BUILD_GIT_COMMIT_HASH automatically.
EXPO_PUBLIC_COMMIT_SHA=

# Google Maps (mobile SDK)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-mobile-maps-key

# Google OAuth Configuration (Optional - for "Sign in with Google")
# Get these from: https://console.cloud.google.com/apis/credentials
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_EXPO_CLIENT_ID=your-expo-client-id.apps.googleusercontent.com

# Stripe Configuration (Optional - for subscriptions and ad payments)
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Feature Flags
# EXPO_PUBLIC_FORCE_SAMPLE_FEED=false

# ------------------------------------------------------------
# VarsityHub Server (Express) - Environment Variables

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Core
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/varsityhub
JWT_SECRET=replace-with-32+char-secret
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:3000
# Set to 1 only for local troubleshooting.
DISABLE_RATE_LIMITING=0
# Legacy alias retained for backwards compatibility in older scripts.
RATE_LIMIT_DISABLE=0
ENABLE_SERVER_DEBUG_LOGS=false
UPLOADS_PUBLIC=0
ENABLE_DEV_CODES=0

# URLs
APP_BASE_URL=https://varsityhub.app
FRONTEND_URL=http://localhost:8081
APP_SCHEME=varsityhubmobile
APP_RETURN_PATH=

# Admin
ADMIN_EMAILS=admin@varsityhub.app
TRANSACTION_REPORT_EMAIL=finance@varsityhub.app
METRICS_REPORT_EMAIL=metrics@varsityhub.app

# Sentry
SENTRY_DSN=https://your-server-key@sentry.io/your-project
# Optional release correlation for Railway / manual deploys
COMMIT_SHA=

# Google OAuth (server)
GOOGLE_OAUTH_CLIENT_IDS=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_AUDIENCE=your-client-id.apps.googleusercontent.com

# Apple Sign In (server)
APPLE_KEY_ID=your-apple-key-id
APPLE_TEAM_ID=YOURTEAMID
APPLE_CLIENT_ID=com.varsityhub.app
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
APPLE_BUNDLE_ID=com.xsantcastx.varsityhub

# Google Maps (server)
GOOGLE_MAPS_API_KEY=your-server-maps-key

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# S3 (optional, if using S3-backed uploads)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Redis (queues, rate limiting)
REDIS_URL=redis://localhost:6379

# Stripe (server)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_VETERAN=
STRIPE_PRICE_LEGEND=
STRIPE_PRICE_AD_WEEKDAY=
STRIPE_PRICE_AD_WEEKEND=

# Email provider
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@varsityhub.app
CUSTOMER_SERVICE_EMAIL=support@varsityhub.app
EMAIL_TIMEOUT_MS=10000
EMAIL_RETRY_ATTEMPTS=2
EMAIL_RETRY_DELAY_MS=1000
EMAIL_ENABLE_QUEUE=false
EMAIL_ENABLE_LOGGING=true

# SendGrid API Key
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# SendGrid Template IDs
SENDGRID_VERIFICATION_TEMPLATE_ID=d-your-verification-template-id
SENDGRID_PASSWORD_RESET_TEMPLATE_ID=d-your-password-reset-template-id
SENDGRID_PASSWORD_CHANGED_TEMPLATE_ID=d-your-password-changed-template-id
SENDGRID_ACCOUNT_RECOVERY_TEMPLATE_ID=d-your-account-recovery-template-id
SENDGRID_LOGIN_NEW_DEVICE_TEMPLATE_ID=d-your-login-new-device-template-id
SENDGRID_REPORT_RESOLVED_TEMPLATE_ID=d-your-report-resolved-template-id
SENDGRID_REPORT_DISMISSED_TEMPLATE_ID=d-your-report-dismissed-template-id
SENDGRID_ACCOUNT_WARNING_TEMPLATE_ID=d-your-account-warning-template-id
SENDGRID_CONTENT_REMOVED_TEMPLATE_ID=d-your-content-removed-template-id
SENDGRID_ACCOUNT_SUSPENSION_7_DAYS_TEMPLATE_ID=d-your-suspension-7-days-template-id
SENDGRID_ACCOUNT_SUSPENSION_45_DAYS_TEMPLATE_ID=d-your-suspension-45-days-template-id
SENDGRID_ACCOUNT_PERMANENT_BAN_TEMPLATE_ID=d-your-permanent-ban-template-id
SENDGRID_EVENT_SUBMISSION_RECEIVED_TEMPLATE_ID=d-your-event-submission-received-template-id
SENDGRID_EVENT_APPROVED_TEMPLATE_ID=d-your-event-approved-template-id
SENDGRID_EVENT_DENIED_TEMPLATE_ID=d-your-event-denied-template-id
SENDGRID_EVENT_REMINDER_TEMPLATE_ID=d-your-event-reminder-template-id
SENDGRID_EVENT_UPDATED_TEMPLATE_ID=d-your-event-updated-template-id
SENDGRID_EVENT_CANCELED_TEMPLATE_ID=d-your-event-canceled-template-id
SENDGRID_EVENT_RSVP_CONFIRMED_TEMPLATE_ID=d-your-event-rsvp-confirmed-template-id
SENDGRID_TEAM_INVITE_TEMPLATE_ID=d-your-team-invite-template-id
SENDGRID_ORG_INVITE_TEMPLATE_ID=d-your-org-invite-template-id
SENDGRID_ATHLETE_INVITATION_TEMPLATE_ID=d-your-athlete-invite-template-id
SENDGRID_ROLE_ASSIGNMENT_TEMPLATE_ID=d-your-role-assignment-template-id
SENDGRID_ROSTER_THRESHOLD_TEMPLATE_ID=d-your-roster-threshold-template-id
SENDGRID_INVITATION_DECLINED_TEMPLATE_ID=d-your-invitation-declined-template-id
SENDGRID_TEAM_ROSTER_UPDATE_TEMPLATE_ID=d-your-team-roster-update-template-id
SENDGRID_STAFF_MEMBER_JOINED_TEMPLATE_ID=d-your-staff-member-joined-template-id
SENDGRID_USER_CONFIRMATION_TEMPLATE_ID=d-your-user-confirmation-template-id
SENDGRID_ABUSE_REPORT_TEMPLATE_ID=d-your-abuse-report-template-id
SENDGRID_JOIN_REQUEST_ADMIN_TEMPLATE_ID=d-your-join-request-admin-template-id
SENDGRID_JOIN_REQUEST_APPROVED_TEMPLATE_ID=d-your-join-request-approved-template-id
SENDGRID_JOIN_REQUEST_DENIED_TEMPLATE_ID=d-your-join-request-denied-template-id
SENDGRID_ORG_APPROVAL_TEMPLATE_ID=d-your-org-approval-template-id
SENDGRID_ORG_DENIAL_TEMPLATE_ID=d-your-org-denial-template-id
SENDGRID_CONTENT_MODERATION_TEMPLATE_ID=d-your-content-moderation-template-id
SENDGRID_BILLING_NOTICE_TEMPLATE_ID=d-your-billing-notice-template-id
SENDGRID_PAYMENT_FAILED_TEMPLATE_ID=d-your-payment-failed-template-id
SENDGRID_SUBSCRIPTION_EXPIRING_TEMPLATE_ID=d-your-subscription-expiring-template-id

# Twilio (optional SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_PHONE=

# Seeds/tests
SEED_PASSWORD=
TEST_PASSWORD=TestPassword123!
SKIP_SERVER_DB_TESTS=0
