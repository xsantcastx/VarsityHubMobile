#!/bin/bash

# Pre-commit hook: light npm audit check
# Ensures no moderate+ vulnerabilities slip into commits

set -e

echo "🔍 Running npm audit (moderate+ threshold)..."

# Audit root - fail only on moderate+ severity
npm audit --audit-level=moderate --json > /tmp/audit-root.json 2>&1 || {
  VULNS=$(jq '.metadata.vulnerabilities.total // 0' /tmp/audit-root.json 2>/dev/null)
  echo "⚠️  Root found $VULNS vulnerabilities"
  jq -r '.vulnerabilities[] | "\(.name)@\(.via[0] // "unknown") [\(.severity)]"' /tmp/audit-root.json 2>/dev/null | head -5
  exit 1
}

# Audit server - fail only on moderate+ severity
(cd server && npm audit --audit-level=moderate --json > /tmp/audit-server.json 2>&1) || {
  VULNS=$(jq '.metadata.vulnerabilities.total // 0' /tmp/audit-server.json 2>/dev/null)
  echo "⚠️  Server found $VULNS vulnerabilities"
  jq -r '.vulnerabilities[] | "\(.name)@\(.via[0] // "unknown") [\(.severity)]"' /tmp/audit-server.json 2>/dev/null | head -5
  exit 1
}

# Update snapshots if clean
npm audit --json > server/npm-audit-root.json 2>/dev/null || true
(cd server && npm audit --json > npm-audit-server.json 2>/dev/null || true) || true

echo "✅ npm audit clean—proceeding with commit"
