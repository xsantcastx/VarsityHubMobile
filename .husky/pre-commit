#!/bin/bash
#
# Pre-commit gate. Mirrors the checks CI runs on a PR so devs don't learn
# about trivial breakage after a push: typecheck + full npm audit.
# Lint is intentionally NOT in the blocking path — it's noisy on in-flight
# work and already runs in CI.
#
# Escape hatch: `git commit --no-verify` when you truly need it (e.g. WIP
# commit on an experiment branch). Abuse of that is caught in review.

set -e

echo "🧠 Typechecking app..."
npx tsc --noEmit

echo "🧠 Typechecking server..."
(cd server && npx tsc --noEmit)

echo "🔍 Running npm audit (all severities)..."

npm audit --json > /tmp/audit-root.json 2>&1 || true
ROOT_VULNS=$(jq '.metadata.vulnerabilities.total // 0' /tmp/audit-root.json 2>/dev/null)
if [ "${ROOT_VULNS:-0}" -ne 0 ]; then
  echo "⚠️  Root found $ROOT_VULNS vulnerabilities"
  jq -r '.vulnerabilities[] | "\(.name)@\(.via[0] // "unknown") [\(.severity)]"' /tmp/audit-root.json 2>/dev/null | head -5
  exit 1
fi

(cd server && npm audit --omit=dev --json > /tmp/audit-server.json 2>&1) || true
SERVER_VULNS=$(jq '.metadata.vulnerabilities.total // 0' /tmp/audit-server.json 2>/dev/null)
if [ "${SERVER_VULNS:-0}" -ne 0 ]; then
  echo "⚠️  Server found $SERVER_VULNS vulnerabilities"
  jq -r '.vulnerabilities[] | "\(.name)@\(.via[0] // "unknown") [\(.severity)]"' /tmp/audit-server.json 2>/dev/null | head -5
  exit 1
fi

echo "✅ pre-commit checks passed"
