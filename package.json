{
  "name": "varsityhubmobile",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "engines": {
    "node": ">=18 <21"
  },
  "packageManager": "npm@10.8.1",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "diagnose:metro": "bash scripts/diagnose-metro.sh",
    "diagnose:env": "node scripts/check-env-alignment.js",
    "web:playwright": "cross-env CI=1 PORT=8081 RCT_METRO_PORT=8081 expo start --web",
    "test:smoke:skip-server": "cross-env PLAYWRIGHT_SKIP_SERVER=1 playwright test",
    "start:ci": "set CI=1&& expo start --port 19001",
    "web:ci": "set CI=1&& expo start --web --port 9500",
    "android:ci": "set CI=1&& expo start --android --port 19002",
    "postinstall": "node ./tools/ensure-simple-swizzle.js && node ./tools/ensure-debug-index.js && node ./tools/patches/patch-router-sitemap.js && node ./tools/ensure-is-arrayish.js && node ./tools/patches/patch-logbox-button.js",
    "fix:deps": "node ./tools/ensure-simple-swizzle.js && node ./tools/ensure-debug-index.js && node ./tools/ensure-is-arrayish.js",
    "lint": "expo lint",
    "lint:strict": "expo lint --fix && npm run typecheck",
    "doctor": "npx expo-doctor",
    "validate:pre-launch": "scripts/validate-pre-launch.bat",
    "build:production": "bash scripts/build-production.sh",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production",
    "server:install": "cd server && npm install",
    "server:dev": "cd server && npm run dev",
    "server:db:migrate": "cd server && npx prisma migrate dev --name init",
    "server:db:seed": "cd server && npm run seed",
    "server:db:studio": "cd server && npx prisma studio",
    "typecheck": "tsc --noEmit",
    "check:email-templates": "node server/scripts/check-email-templates.js",
    "test": "jest --runInBand",
    "test:smoke": "playwright test",
    "test:smoke:ui": "playwright test --ui",
    "test:smoke:headed": "playwright test --headed",
    "test:smoke:debug": "playwright test --debug",
    "smoke:deeplink:android:reset": "bash scripts/deep-link-smoke.sh android reset",
    "smoke:deeplink:android:verify": "bash scripts/deep-link-smoke.sh android verify",
    "smoke:deeplink:ios:reset": "bash scripts/deep-link-smoke.sh ios reset",
    "smoke:deeplink:ios:verify": "bash scripts/deep-link-smoke.sh ios verify"
  },
  "dependencies": {
    "@base44/sdk": "^0.7.0",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.3",
    "@lottiefiles/dotlottie-react": "^0.13.5",
    "@prisma/client": "^7.0.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.3.2",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@react-navigation/native-stack": "^7.3.2",
    "@sentry/react-native": "~7.2.0",
    "@types/react": "~19.1.10",
    "date-fns": "^4.1.0",
    "expo": "~54.0.30",
    "expo-apple-authentication": "~8.0.7",
    "expo-application": "~7.0.7",
    "expo-asset": "~12.0.12",
    "expo-audio": "~1.1.1",
    "expo-auth-session": "~7.0.9",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.18",
    "expo-device": "~8.0.9",
    "expo-document-picker": "~14.0.7",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.7",
    "expo-media-library": "~18.2.0",
    "expo-notifications": "~0.32.15",
    "expo-router": "~6.0.21",
    "expo-secure-store": "~15.0.7",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.15",
    "expo-video": "~3.0.14",
    "expo-web-browser": "~15.0.9",
    "jest-expo": "~54.0.16",
    "lottie-ios": "4.5.0",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-google-places-autocomplete": "^2.5.7",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "4.0.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "sentry-expo": "^7.2.0",
    "tslib": "^2.6.2",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@react-native-community/cli": "^20.0.2",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "cross-env": "^10.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-native": "^4.0.0",
    "jest": "^30.2.0",
    "jest-expo": "~54.0.16",
    "react-test-renderer": "19.1.0"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/slider"
      ]
    }
  },
  "prisma": {
    "schema": "server/prisma/schema.prisma"
  },
  "overrides": {
    "react-native-calendars": {
      "react-native-safe-area-context": "5.6.2"
    },
    "@sentry/react-native": "~7.2.0",
    "glob": ">=10.0.0"
  }
}
