# Snyk Policy File (.snyk)
# Supports: version, ignore, patch
# Documentation: https://docs.snyk.io/snyk-cli/test-for-vulnerabilities/the-.snyk-file

version: v1.29.0

ignore:
  # ─── Transitive dependency vulnerabilities (no direct fix available) ───

  SNYK-JS-SENTRYCORE-14105053:
    - '*':
        reason: 'Transitive dependency in @sentry/react-native. Upgrade to @sentry/react-native@7.8.0+ resolves this. Tracked for next dependency update cycle.'
        expires: '2026-06-30T23:59:59Z'

  SNYK-JS-ELLIPTIC-8187303:
    - '*':
        reason: 'CVE-2024-48948 in elliptic@6.6.1 (transitive via jwk-to-pem@2.0.7). Used for JWT key verification only (asymmetric). Monitoring for upstream fix.'
        expires: '2026-09-30T23:59:59Z'

  SNYK-JS-INFLIGHT-6095116:
    - '*':
        reason: 'Missing resource release in inflight@1.0.6 (transitive via glob/react-native). Build-time and dev dependency only. No upstream fix available.'
        expires: '2026-09-30T23:59:59Z'

  SNYK-JS-SOCKETIOPARSER-15680278:
    - '*':
        reason: 'Transitive via @base44/sdk > socket.io-client > socket.io-parser@4.2.5. Fixed in 4.2.6 but requires @base44/sdk to update socket.io-client. No direct upgrade path.'
        expires: '2026-09-30T23:59:59Z'

  # ─── XSS: HTML admin confirmation pages — sanitized via escapeHtml() ───
  # Snyk SAST cannot trace escapeHtml() as a sanitizer in data flow analysis.
  # All user-controlled values are escaped before interpolation into HTML.

  javascript/XSS:
    - 'server/src/routes/organizations.ts':
        reason: 'League approve/reject HTML responses sanitize org.name via escapeHtml() from escape-html package. Verified safe — Snyk SAST false positive.'
        expires: '2027-03-27T23:59:59Z'
    - 'server/src/routes/ads.ts':
        reason: 'Ad approve/reject HTML responses sanitize all interpolated values via escapeHtml() from escape-html package. Verified safe — Snyk SAST false positive.'
        expires: '2027-03-27T23:59:59Z'

  # ─── Uploads.ts filesystem operation — already rate-limited ───

  javascript/PT:
    - 'server/src/routes/uploads.ts':
        reason: 'Avatar upload endpoint already has requireAuth + uploadLimiter middleware. Snyk does not recognize custom rate limiter middleware. False positive.'
        expires: '2027-03-27T23:59:59Z'

  # ─── Cloudinary SHA-1 hash — required by Cloudinary API ───

  javascript/InsecureHash:
    - 'server/src/lib/cloudinary.ts':
        reason: 'Cloudinary API requires SHA-1 for request signature authentication per their official documentation. Not a password hash.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/routes/uploads.ts':
        reason: 'SHA-1 used for Cloudinary upload signature, required by their API. Not used for password/credential hashing.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/lib/wipeProduction.ts':
        reason: 'SHA-256 hash used for verification token comparison. Snyk misflags as insecure but SHA-256 is secure. False positive.'
        expires: '2099-12-31T23:59:59Z'

  # ─── Test fixtures: hardcoded credentials, passwords, secrets ───
  # All files below are test/script-only — never deployed to production.
  # Test passwords are intentionally hardcoded for reproducible test runs.

  javascript/NoHardcodedCredentials:
    - 'server/mock-server.js':
        reason: 'Mock development server — never runs in production. Uses hardcoded mock credentials for development/testing.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/lib/email.ts':
        reason: 'SENDGRID_API_KEY is initialized from environment variable, not hardcoded. Snyk misidentifies env var read as hardcoded value.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/__tests__/*':
        reason: 'Test fixtures use hardcoded test credentials for unit/integration testing. Non-production values.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/tests/*':
        reason: 'Test fixtures use hardcoded test credentials for integration testing. Non-production values.'
        expires: '2099-12-31T23:59:59Z'

  javascript/HardcodedNonCryptoSecret/test:
    - 'server/src/__tests__/*':
        reason: 'Test fixtures use hardcoded test values for unit testing. Non-production values.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/scripts/*':
        reason: 'Verification/test scripts use hardcoded test values. Non-production, never deployed.'
        expires: '2099-12-31T23:59:59Z'

  javascript/NoHardcodedPasswords/test:
    - 'server/src/__tests__/*':
        reason: 'Test fixtures use hardcoded test passwords for unit testing. Non-production values.'
        expires: '2099-12-31T23:59:59Z'

  javascript/NoHardcodedPasswords:
    - 'server/scripts/*':
        reason: 'Verification/test scripts use hardcoded test passwords. Non-production, never deployed.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/__tests__/*':
        reason: 'Test fixtures use hardcoded test passwords for unit/integration testing. Non-production values.'
        expires: '2099-12-31T23:59:59Z'
    - 'tests/*':
        reason: 'E2E and API test specs use hardcoded test passwords. Non-production values.'
        expires: '2099-12-31T23:59:59Z'

  javascript/HardcodedSecret:
    - 'server/scripts/*':
        reason: 'Test/verification scripts use hardcoded bcrypt hashes for test user creation. Non-production, never deployed.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/__tests__/*':
        reason: 'Test fixtures use hardcoded bcrypt hashes for test user creation. Non-production values.'
        expires: '2099-12-31T23:59:59Z'

  javascript/HardcodedCipherKey:
    - 'server/scripts/security-test.ts':
        reason: 'Test script intentionally uses hardcoded JWT secret to verify security constraints. Non-production, never deployed.'
        expires: '2099-12-31T23:59:59Z'

  # ─── Test app X-Powered-By (test-only, not production app.ts) ───

  javascript/ExpressXPoweredBy:
    - 'server/src/__tests__/access-matrix.test.ts':
        reason: 'Test setup file creates minimal Express app for testing. Not deployed to production. Production app uses Helmet which disables X-Powered-By.'
        expires: '2099-12-31T23:59:59Z'

  # ─── Mock server prototype pollution (test-only) ───

  javascript/PrototypePollution:
    - 'server/mock-server.js':
        reason: 'Mock server for development only — never runs in production. body.split() is controlled input from test client.'
        expires: '2099-12-31T23:59:59Z'

patch: {}
