# Snyk Policy File (.snyk)
# Supports: version, ignore, patch
# Documentation: https://docs.snyk.io/snyk-cli/test-for-vulnerabilities/the-.snyk-file

version: v1.29.0

ignore:
  SNYK-JS-SENTRYCORE-14105053:
    - '*':
        reason: 'Transitive dependency in @sentry/react-native. Upgrade to @sentry/react-native@7.8.0+ resolves this. Tracked for next dependency update cycle.'
        expires: '2026-06-30T23:59:59Z'

  # Test fixtures with hardcoded credentials - these are non-production test values only
  # All are in test files (__tests__) and mock-server.js (development only)
  javascript/HardcodedNonCryptoSecret/test:
    - 'server/src/__tests__/auth.test.ts':
        reason: 'Test fixtures use hardcoded test credentials for unit testing. Non-production values. Production uses environment variables.'
        expires: '2099-12-31T23:59:59Z'

  javascript/NoHardcodedCredentials:
    - 'server/mock-server.js':
        reason: 'Mock development server only - never runs in production (throws error if NODE_ENV is production). Uses hardcoded mock credentials for development/testing.'
        expires: '2099-12-31T23:59:59Z'
    - 'server/src/lib/email.ts':
        reason: 'SENDGRID_API_KEY is initialized from environment variable, not hardcoded. snyk:ignore directive in code.'
        expires: '2099-12-31T23:59:59Z'

  javascript/NoHardcodedPasswords/test:
    - 'server/src/__tests__/auth.test.ts':
        reason: 'Test fixtures use hardcoded test passwords for unit testing. Non-production values. Production uses environment variables.'
        expires: '2099-12-31T23:59:59Z'

  javascript/InsecureHash:
    - 'server/src/lib/cloudinary.ts':
        reason: 'Cloudinary API requires SHA-1 for request signature authentication per their official documentation. Not a password hash. See: https://cloudinary.com/documentation/upload_widget#signed_uploads'
        expires: '2099-12-31T23:59:59Z'

  SNYK-JS-ELLIPTIC-8187303:
    - '*':
        reason: 'CVE-2024-48948 in elliptic@6.6.1 (transitive via jwk-to-pem@2.0.7). Used for JWT key verification only (asymmetric). Monitoring for upstream fix.'
        expires: '2026-09-30T23:59:59Z'

  SNYK-JS-INFLIGHT-6095116:
    - '*':
        reason: 'Missing resource release in inflight@1.0.6 (transitive via glob/react-native). Build-time and dev dependency only. No upstream fix available.'
        expires: '2026-09-30T23:59:59Z'

  javascript/XSS:
    - 'server/src/routes/organizations.ts':
        reason: 'League approve/reject HTML responses sanitize org.name via escape-html package. Snyk SAST does not recognize escapeHtml() as a sanitizer in data flow analysis. Verified safe.'
        expires: '2027-03-18T23:59:59Z'

  SNYK-JS-SOCKETIOPARSER-15680278:
    - '*':
        reason: 'Transitive via @base44/sdk > socket.io-client > socket.io-parser@4.2.5. Fixed in 4.2.6 but requires @base44/sdk to update socket.io-client. No direct upgrade path.'
        expires: '2026-09-30T23:59:59Z'

patch: {}
